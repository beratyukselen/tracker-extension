{
  "manifest_version": 3,
  "name": "CleanSheet Assistant Pro",
  "version": "1.1.1",
  "description": "Arka planda sekme ve süre takibi yapar.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanSheet Assistant Pro",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}