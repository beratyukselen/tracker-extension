{
  "manifest_version": 3,
  "name": "Activity Analyst",
  "version": "1.0",
  "description": "Arka planda sekme ve süre takibi yapar.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}